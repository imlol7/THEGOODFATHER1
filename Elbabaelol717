-- Anti-hit protection (basic)
local function AntiHit()
    LocalPlayer.CharacterAdded:Connect(function(character)
        wait(1)
        local humanoid = character:WaitForChild("Humanoid")
        
        humanoid.Touched:Connect(function(hit)
            if hit and hit.Parent then
                -- Basic anti-stun/anti-knockback
                if hit.Parent:FindFirstChildOfClass("Tool") or hit.Name:lower():find("weapon") then
                    -- Try to mitigate damage
                    if humanoid.Health < 50 then
                        -- Emergency teleport to safe zone
                        local safeZone = workspace:FindFirstChild("SafeZone") or workspace:FindFirstChild("Spawn")
                        if safeZone then
                            character:SetPrimaryPartCFrame(safeZone.CFrame + Vector3.new(0, 5, 0))
                        end
                    end
                end
            end
        end)
    end)
end

