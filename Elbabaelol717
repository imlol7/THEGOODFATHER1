        local conveyor = workspace:FindFirstChild("ConveyorBelt") or workspace:FindFirstChild("Conveyor")
        if conveyor then
            for _, part in pairs(conveyor:GetDescendants()) do
                if not Functions.AutoBuy then break end
                
                if part:IsA("ClickDetector") then
                    fireclickdetector(part)
                    HumanWait()
                end
            end
        end
    end
end

-- ESP System
function UpdateESP()
    -- Clear existing highlights
    for _, highlight in pairs(ESPHighlights) do
        highlight:Destroy()
    end
    ESPHighlights = {}
    
    -- Brainrot ESP
    if Functions.BrainrotESP then
        local brainrots = FindBrainrots()
        for _, brainrot in pairs(brainrots) do
            local highlight = Instance.new("Highlight")
            highlight.Parent = brainrot
            highlight.FillColor = Color3.fromRGB(0, 255, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.Adornee = brainrot
            table.insert(ESPHighlights, highlight)
        end
    end
    
    -- Player ESP
    if Functions.PlayerESP then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local highlight = Instance.new("Highlight")
                highlight.Parent = player.Character
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Adornee = player.Character
                table.insert(ESPHighlights, highlight)
            end
        end
    end
    
    -- Base ESP (find player bases)
    if Functions.BaseESP then
        -- Look for base structures
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name:lower():find("base") or obj.Name:lower():find("plot") then
                local highlight = Instance.new("Highlight")
                highlight.Parent = obj
                highlight.FillColor = Color3.fromRGB(0, 0, 255)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.Adornee = obj
                table.insert(ESPHighlights, highlight)
            end
        end
    end
end

-- Server hopping function
function ServerHop()
    local servers = {}
    local placeId = game.PlaceId
    
    -- Get server list (simplified version)
    pcall(function()
        local response = game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"))
        
        if response and response.data then
            for _, server in pairs(response.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end
        end
    end)
    
    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        TeleportService:TeleportToPlaceInstance(placeId, randomServer, LocalPlayer)
    else
        -- Fallback: rejoin same game
        TeleportService:Teleport(placeId, LocalPlayer)
    end
end

