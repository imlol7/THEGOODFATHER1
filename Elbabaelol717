-- Humanizer function
function HumanWait()
    local delay = Random.new():NextNumber(Elol.Humanizer.RandomDelay.min, Elol.Humanizer.RandomDelay.max)
    wait(delay)
end

-- Find Brainrot objects
function FindBrainrots()
    local brainrots = {}
    
    -- Look for brainrots in workspace
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:lower():find("brainrot") or obj.Name:lower():find("pet") then
            if obj:IsA("BasePart") or obj:IsA("Model") then
                table.insert(brainrots, obj)
            end
        end
    end
    
    -- Check conveyor belt area
    local conveyor = workspace:FindFirstChild("ConveyorBelt") or workspace:FindFirstChild("Conveyor")
    if conveyor then
        for _, item in pairs(conveyor:GetDescendants()) do
            if item:IsA("BasePart") and item.Name:lower():find("brainrot") then
                table.insert(brainrots, item)
            end
        end
    end
    
    return brainrots
end

-- Auto Collect function
function AutoCollectLoop()
    while Functions.AutoCollect do
        HumanWait()
        
        -- Find and click money collectors
        for _, obj in pairs(workspace:GetDescendants()) do
            if not Functions.AutoCollect then break end
            
            if obj.Name:lower():find("collect") or obj.Name:lower():find("money") or obj.Name:lower():find("income") then
                if obj:IsA("ClickDetector") then
                    fireclickdetector(obj)
                    HumanWait()
                elseif obj:IsA("Part") and obj:FindFirstChild("ClickDetector") then
                    fireclickdetector(obj.ClickDetector)
                    HumanWait()
                end
            end
        end
        
        -- Check for UI collect buttons
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in pairs(playerGui:GetDescendants()) do
                if not Functions.AutoCollect then break end
                
                if gui:IsA("TextButton") and (gui.Text:lower():find("collect") or gui.Text:lower():find("claim")) then
                    pcall(function()
                        gui:FireServer("Activated")
                    end)
                    HumanWait()
                end
            end
        end
    end
end

-- Auto Buy function
function AutoBuyLoop()
    while Functions.AutoBuy do
        HumanWait()
        
        -- Look for buy buttons and conveyor interactions
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in pairs(playerGui:GetDescendants()) do
