-- Notification system
local function Notify(message)
    local notification = Instance.new("TextLabel")
    notification.Parent = ElolGUI
    notification.Size = UDim2.new(0, 300, 0, 40)
    notification.Position = UDim2.new(0.5, -150, 1, 10)
    notification.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    notification.TextColor3 = Color3.fromRGB(255, 255, 255)
    notification.Text = "🧠 " .. message
    notification.Font = Enum.Font.Gotham
    notification.TextSize = 12
    notification.ZIndex = 10
    
    -- Animate
    local tween = game:GetService("TweenService"):Create(
        notification,
        TweenInfo.new(0.5),
        {Position = UDim2.new(0.5, -150, 1, -50)}
    )
    tween:Play()
    
    wait(3)
    
    local tweenOut = game:GetService("TweenService"):Create(
        notification,
        TweenInfo.new(0.5),
        {Position = UDim2.new(0.5, -150, 1, 10)}
    )
    tweenOut:Play()
    
    tweenOut.Completed:Connect(function()
        notification:Destroy()
    end)
end

